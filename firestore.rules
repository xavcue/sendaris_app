rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated()
        && request.auth.uid == uid;
    }

    function hasValidTrackingProfileFields() {
      return request.resource.data.keys().hasAll([
          'fechaCreacion',
          'activo'
        ])
        && request.resource.data.keys().hasOnly([
          'fechaCreacion',
          'activo'
        ])
        && request.resource.data.fechaCreacion is timestamp
        && request.resource.data.activo is bool;
    }

    function isValidTrackingProfileCreate() {
      return hasValidTrackingProfileFields();
    }

    function isValidTrackingProfileUpdate() {
      return hasValidTrackingProfileFields()
        && request.resource.data.fechaCreacion
          == resource.data.fechaCreacion;
    }

    function trackingProfileExistsAndIsActive(
      uid,
      idAnonimo
    ) {
      return exists(
          /databases/$(database)/documents
          /usuarios/$(uid)/seguimientos/$(idAnonimo)
        )
        && get(
          /databases/$(database)/documents
          /usuarios/$(uid)/seguimientos/$(idAnonimo)
        ).data.activo == true;
    }

    function hasValidBehaviorTopLevelFields(uid) {
      return request.resource.data.keys().hasAll([
          'tipoRegistro',
          'fechaEvento',
          'fechaCreacion',
          'fechaActualizacion',
          'uidOperacion',
          'datos'
        ])
        && request.resource.data.keys().hasOnly([
          'tipoRegistro',
          'fechaEvento',
          'fechaCreacion',
          'fechaActualizacion',
          'uidOperacion',
          'datos'
        ])
        && request.resource.data.tipoRegistro == 'conducta'
        && request.resource.data.fechaEvento is timestamp
        && request.resource.data.fechaCreacion is timestamp
        && request.resource.data.fechaActualizacion is timestamp
        && request.resource.data.fechaCreacion
          == request.resource.data.fechaActualizacion
        && request.resource.data.uidOperacion is string
        && request.resource.data.uidOperacion == uid
        && request.resource.data.uidOperacion
          == request.auth.uid
        && request.resource.data.datos is map;
    }

    function hasValidBehaviorDataFields() {
      return request.resource.data.datos.keys().hasAll([
          'fecha',
          'categoria'
        ])
        && request.resource.data.datos.keys().hasOnly([
          'fecha',
          'hora',
          'categoria',
          'duracionMin',
          'intensidad',
          'contexto',
          'observacion'
        ]);
    }

    function hasValidBehaviorDate() {
      return request.resource.data.datos.fecha is timestamp;
    }

    function hasValidBehaviorCategory() {
      return request.resource.data.datos.categoria is string
        && request.resource.data.datos.categoria in [
          'agresion_irritabilidad',
          'evitacion_miedo',
          'conducta_repetitiva',
          'iniciativa_social'
        ];
    }

    function hasValidOptionalBehaviorTime() {
      return !('hora' in request.resource.data.datos)
        || (
          request.resource.data.datos.hora is string
          && request.resource.data.datos.hora.matches(
            '^([01][0-9]|2[0-3]):[0-5][0-9]$'
          )
        );
    }

    function hasValidOptionalBehaviorDuration() {
      return !('duracionMin' in request.resource.data.datos)
        || (
          request.resource.data.datos.duracionMin is int
          && request.resource.data.datos.duracionMin > 0
        );
    }

    function hasValidOptionalBehaviorIntensity() {
      return !('intensidad' in request.resource.data.datos)
        || (
          request.resource.data.datos.intensidad is string
          && request.resource.data.datos.intensidad in [
            'baja',
            'media',
            'alta'
          ]
        );
    }

    function hasValidOptionalBehaviorContext() {
      return !('contexto' in request.resource.data.datos)
        || (
          request.resource.data.datos.contexto is string
          && request.resource.data.datos.contexto.size() > 0
        );
    }

    function hasValidOptionalBehaviorObservation() {
      return !('observacion' in request.resource.data.datos)
        || (
          request.resource.data.datos.observacion is string
          && request.resource.data.datos.observacion.size() > 0
        );
    }

    function isValidBehaviorCreate(uid) {
      return hasValidBehaviorTopLevelFields(uid)
        && hasValidBehaviorDataFields()
        && hasValidBehaviorDate()
        && hasValidBehaviorCategory()
        && hasValidOptionalBehaviorTime()
        && hasValidOptionalBehaviorDuration()
        && hasValidOptionalBehaviorIntensity()
        && hasValidOptionalBehaviorContext()
        && hasValidOptionalBehaviorObservation();
    }

    function hasValidSleepTopLevelFields(uid) {
      return request.resource.data.keys().hasAll([
          'tipoRegistro',
          'fechaEvento',
          'fechaCreacion',
          'fechaActualizacion',
          'uidOperacion',
          'datos'
        ])
        && request.resource.data.keys().hasOnly([
          'tipoRegistro',
          'fechaEvento',
          'fechaCreacion',
          'fechaActualizacion',
          'uidOperacion',
          'datos'
        ])
        && request.resource.data.tipoRegistro == 'sueno'
        && request.resource.data.fechaEvento is timestamp
        && request.resource.data.fechaCreacion is timestamp
        && request.resource.data.fechaActualizacion is timestamp
        && request.resource.data.fechaCreacion
          == request.resource.data.fechaActualizacion
        && request.resource.data.uidOperacion is string
        && request.resource.data.uidOperacion == uid
        && request.resource.data.uidOperacion
          == request.auth.uid
        && request.resource.data.datos is map;
    }

    function hasValidSleepDataFields() {
      return request.resource.data.datos.keys().hasAll([
          'fecha',
          'horaInicio',
          'horaFin',
          'duracionMin'
        ])
        && request.resource.data.datos.keys().hasOnly([
          'fecha',
          'horaInicio',
          'horaFin',
          'duracionMin',
          'observacion'
        ]);
    }

    function hasValidSleepDate() {
      return request.resource.data.datos.fecha is timestamp;
    }

    function hasValidSleepStartTime() {
      return request.resource.data.datos.horaInicio is string
        && request.resource.data.datos.horaInicio.matches(
          '^([01][0-9]|2[0-3]):[0-5][0-9]$'
        );
    }

    function hasValidSleepEndTime() {
      return request.resource.data.datos.horaFin is string
        && request.resource.data.datos.horaFin.matches(
          '^([01][0-9]|2[0-3]):[0-5][0-9]$'
        );
    }

    function hasDistinctSleepTimes() {
      return request.resource.data.datos.horaInicio
        != request.resource.data.datos.horaFin;
    }

    function hasValidSleepDuration() {
      return request.resource.data.datos.duracionMin is int
        && request.resource.data.datos.duracionMin > 0
        && request.resource.data.datos.duracionMin < 1440;
    }

    function hasValidOptionalSleepObservation() {
      return !('observacion' in request.resource.data.datos)
        || (
          request.resource.data.datos.observacion is string
          && request.resource.data.datos.observacion.size() > 0
        );
    }

    function isValidSleepCreate(uid) {
      return hasValidSleepTopLevelFields(uid)
        && hasValidSleepDataFields()
        && hasValidSleepDate()
        && hasValidSleepStartTime()
        && hasValidSleepEndTime()
        && hasDistinctSleepTimes()
        && hasValidSleepDuration()
        && hasValidOptionalSleepObservation();
    }

    function hasValidFeedingTopLevelFields(uid) {
      return request.resource.data.keys().hasAll([
          'tipoRegistro',
          'fechaEvento',
          'fechaCreacion',
          'fechaActualizacion',
          'uidOperacion',
          'datos'
        ])
        && request.resource.data.keys().hasOnly([
          'tipoRegistro',
          'fechaEvento',
          'fechaCreacion',
          'fechaActualizacion',
          'uidOperacion',
          'datos'
        ])
        && request.resource.data.tipoRegistro == 'alimentacion'
        && request.resource.data.fechaEvento is timestamp
        && request.resource.data.fechaCreacion is timestamp
        && request.resource.data.fechaActualizacion is timestamp
        && request.resource.data.fechaCreacion
          == request.resource.data.fechaActualizacion
        && request.resource.data.uidOperacion is string
        && request.resource.data.uidOperacion == uid
        && request.resource.data.uidOperacion
          == request.auth.uid
        && request.resource.data.datos is map;
    }

    function hasValidFeedingDataFields() {
      return request.resource.data.datos.keys().hasAll([
          'fecha',
          'categoria'
        ])
        && request.resource.data.datos.keys().hasOnly([
          'fecha',
          'categoria',
          'observacion'
        ]);
    }

    function hasValidFeedingDate() {
      return request.resource.data.datos.fecha is timestamp
        && request.resource.data.fechaEvento
          == request.resource.data.datos.fecha;
    }

    function hasValidFeedingCategory() {
      return request.resource.data.datos.categoria is string
        && request.resource.data.datos.categoria in [
          'desayuno',
          'refrigerio',
          'almuerzo',
          'merienda_cena',
          'otro'
        ];
    }

    function hasValidOptionalFeedingObservation() {
      return !('observacion' in request.resource.data.datos)
        || (
          request.resource.data.datos.observacion is string
          && request.resource.data.datos.observacion.size() > 0
        );
    }

    function isValidFeedingCreate(uid) {
      return hasValidFeedingTopLevelFields(uid)
        && hasValidFeedingDataFields()
        && hasValidFeedingDate()
        && hasValidFeedingCategory()
        && hasValidOptionalFeedingObservation();
    }

    function hasValidRoutineStatusTopLevelFields(uid) {
      return request.resource.data.keys().hasAll([
          'tipoRegistro',
          'fechaEvento',
          'fechaCreacion',
          'fechaActualizacion',
          'uidOperacion',
          'datos'
        ])
        && request.resource.data.keys().hasOnly([
          'tipoRegistro',
          'fechaEvento',
          'fechaCreacion',
          'fechaActualizacion',
          'uidOperacion',
          'datos'
        ])
        && request.resource.data.tipoRegistro == 'estadoRutina'
        && request.resource.data.fechaEvento is timestamp
        && request.resource.data.fechaCreacion is timestamp
        && request.resource.data.fechaActualizacion is timestamp
        && request.resource.data.fechaCreacion
          == request.resource.data.fechaActualizacion
        && request.resource.data.uidOperacion is string
        && request.resource.data.uidOperacion == uid
        && request.resource.data.uidOperacion
          == request.auth.uid
        && request.resource.data.datos is map;
    }

    function hasValidRoutineStatusDataFields() {
      return request.resource.data.datos.keys().hasAll([
          'fecha',
          'idRutina',
          'estado'
        ])
        && request.resource.data.datos.keys().hasOnly([
          'fecha',
          'idRutina',
          'estado',
          'observacion'
        ]);
    }

    function hasValidRoutineStatusDate() {
      return request.resource.data.datos.fecha is timestamp
        && request.resource.data.fechaEvento
          == request.resource.data.datos.fecha;
    }

    function hasValidRoutineStatusRoutineId() {
      return request.resource.data.datos.idRutina is string
        && request.resource.data.datos.idRutina.size() > 0;
    }

    function hasValidRoutineStatusValue() {
      return request.resource.data.datos.estado is string
        && request.resource.data.datos.estado in [
          'completada',
          'modificada',
          'interrumpida',
          'no_realizada'
        ];
    }

    function hasValidOptionalRoutineStatusObservation() {
      return !('observacion' in request.resource.data.datos)
        || (
          request.resource.data.datos.observacion is string
          && request.resource.data.datos.observacion.size() > 0
        );
    }

    function routineExistsAndIsActive(
      uid,
      idAnonimo,
      idRutina
    ) {
      return exists(
          /databases/$(database)/documents
          /usuarios/$(uid)/seguimientos/$(idAnonimo)
          /rutinas/$(idRutina)
        )
        && get(
          /databases/$(database)/documents
          /usuarios/$(uid)/seguimientos/$(idAnonimo)
          /rutinas/$(idRutina)
        ).data.activa == true;
    }

    function isValidRoutineStatusCreate(
      uid,
      idAnonimo
    ) {
      return hasValidRoutineStatusTopLevelFields(uid)
        && hasValidRoutineStatusDataFields()
        && hasValidRoutineStatusDate()
        && hasValidRoutineStatusRoutineId()
        && hasValidRoutineStatusValue()
        && hasValidOptionalRoutineStatusObservation()
        && routineExistsAndIsActive(
          uid,
          idAnonimo,
          request.resource.data.datos.idRutina
        );
    }

    function hasValidAtypicalSituationTopLevelFields(uid) {
      return request.resource.data.keys().hasAll([
          'tipoRegistro',
          'fechaEvento',
          'fechaCreacion',
          'fechaActualizacion',
          'uidOperacion',
          'datos'
        ])
        && request.resource.data.keys().hasOnly([
          'tipoRegistro',
          'fechaEvento',
          'fechaCreacion',
          'fechaActualizacion',
          'uidOperacion',
          'datos'
        ])
        && request.resource.data.tipoRegistro
          == 'situacionAtipica'
        && request.resource.data.fechaEvento is timestamp
        && request.resource.data.fechaCreacion is timestamp
        && request.resource.data.fechaActualizacion is timestamp
        && request.resource.data.fechaCreacion
          == request.resource.data.fechaActualizacion
        && request.resource.data.uidOperacion is string
        && request.resource.data.uidOperacion == uid
        && request.resource.data.uidOperacion
          == request.auth.uid
        && request.resource.data.datos is map;
    }

    function hasValidAtypicalSituationDataFields() {
      return request.resource.data.datos.keys().hasAll([
          'fecha',
          'categoriaGeneral',
          'observacion'
        ])
        && request.resource.data.datos.keys().hasOnly([
          'fecha',
          'categoriaGeneral',
          'observacion'
        ]);
    }

    function hasValidAtypicalSituationDate() {
      return request.resource.data.datos.fecha is timestamp
        && request.resource.data.fechaEvento
          == request.resource.data.datos.fecha;
    }

    function hasValidAtypicalSituationCategory() {
      return request.resource.data.datos.categoriaGeneral is string
        && request.resource.data.datos.categoriaGeneral in [
          'cambio_entorno',
          'transicion_traslado',
          'evento_inesperado',
          'actividad_no_habitual',
          'cambio_horario',
          'interrupcion_externa',
          'otro'
        ];
    }

    function hasValidAtypicalSituationObservation() {
      return request.resource.data.datos.observacion is string
        && request.resource.data.datos.observacion.size() > 0;
    }

    function isValidAtypicalSituationCreate(uid) {
      return hasValidAtypicalSituationTopLevelFields(uid)
        && hasValidAtypicalSituationDataFields()
        && hasValidAtypicalSituationDate()
        && hasValidAtypicalSituationCategory()
        && hasValidAtypicalSituationObservation();
    }

    function hasValidRoutineFields() {
      return request.resource.data.keys().hasAll([
          'nombre',
          'activa'
        ])
        && request.resource.data.keys().hasOnly([
          'nombre',
          'descripcion',
          'horaProgramada',
          'recurrencia',
          'activa'
        ])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.activa is bool
        && (
          !('descripcion' in request.resource.data)
          || (
            request.resource.data.descripcion is string
            && request.resource.data.descripcion.size() > 0
          )
        )
        && (
          !('horaProgramada' in request.resource.data)
          || (
            request.resource.data.horaProgramada is string
            && request.resource.data.horaProgramada.matches(
              '^([01][0-9]|2[0-3]):[0-5][0-9]$'
            )
          )
        )
        && (
          !('recurrencia' in request.resource.data)
          || (
            request.resource.data.recurrencia is string
            && request.resource.data.recurrencia in [
              'diaria',
              'semanal',
              'mensual'
            ]
          )
        );
    }

    function isValidRoutineCreate() {
      return hasValidRoutineFields()
        && request.resource.data.activa == true;
    }

    function isValidRoutineUpdate() {
      return hasValidRoutineFields()
        && (
          resource.data.activa == true
          || request.resource.data.activa == false
        );
    }

    match /usuarios/{uid} {
      allow read, write: if false;

      match /seguimientos/{idAnonimo} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && isValidTrackingProfileCreate();

        allow update: if isOwner(uid)
          && isValidTrackingProfileUpdate();

        allow delete: if false;

        match /registros/{idRegistro} {
          allow read: if isOwner(uid);

          // HU-02: conducta.
          // HU-04: estado de rutina.
          // HU-05: sueño.
          // HU-06: alimentación.
          // HU-09: otra situación.
          allow create: if isOwner(uid)
            && trackingProfileExistsAndIsActive(
              uid,
              idAnonimo
            )
            && (
              isValidBehaviorCreate(uid)
              || isValidSleepCreate(uid)
              || isValidFeedingCreate(uid)
              || isValidRoutineStatusCreate(
                uid,
                idAnonimo
              )
              || isValidAtypicalSituationCreate(uid)
            );

          allow update, delete: if false;
        }

        match /rutinas/{idRutina} {
          allow read: if isOwner(uid);

          allow create: if isOwner(uid)
            && trackingProfileExistsAndIsActive(
              uid,
              idAnonimo
            )
            && isValidRoutineCreate();

          allow update: if isOwner(uid)
            && trackingProfileExistsAndIsActive(
              uid,
              idAnonimo
            )
            && isValidRoutineUpdate();

          allow delete: if false;
        }

        match /reportes/{idReporte} {
          allow read, write: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}